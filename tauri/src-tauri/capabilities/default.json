{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The AutoSim UI (served by the local backend) may open native file dialogs and read / write the files the user picked in them.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "window-state:default"
  ]
}
