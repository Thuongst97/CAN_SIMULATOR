{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoSim Studio",
  "version": "1.2.9",
  "identifier": "com.autosim.studio",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ICAN",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "publisher": "AutoSim",
    "shortDescription": "CAN / CAN FD simulator",
    "longDescription": "AutoSim Studio: simulate CAN / CAN FD nodes, analyse the bus, answer requests automatically and publish signals to test systems.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../dist/AutoSimWeb/": "backend/",
      "../../docs/TEST_API_GUIDE.md": "docs/TEST_API_GUIDE.md"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
